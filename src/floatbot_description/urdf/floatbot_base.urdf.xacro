<?xml version="1.0" encoding="UTF-8"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="base_diameter" value=".3"/>
    <xacro:property name="base_height" value=".48"/>

    <xacro:macro name="floatbot_base" params="prefix">
        <link name="${prefix}base_footprint"/>

        <link name="${prefix}base_link">
            <visual>
                <geometry>
                    <cylinder radius="${base_diameter/2}" length="${base_height}"/>
                </geometry>

                <material name="blue">
                    <color rgba="0.0 0.0 1.0 1.0"/>
                </material>
                
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </visual>

            <collision>
                <geometry>
                    <cylinder radius="${base_diameter/2}" length="${base_height}"/>
                </geometry>

                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            </collision>
        </link>

        <joint name="${prefix}base_joint" type="fixed">
            <parent link="${prefix}base_footprint"/>

            <child link="${prefix}base_link"/>
            
            <origin xyz="0.0 0.0 ${base_height/2}" rpy="0.0 0.0 0.0"/>
        </joint>
    </xacro:macro>
</robot>