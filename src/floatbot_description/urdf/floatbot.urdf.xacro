<?xml version="1.0" encoding="UTF-8"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="floatbot">
    <xacro:arg name="robot_name" default="floatbot"/>
    <xacro:arg name="prefix" default=""/>
    <xacro:arg name="tag_id" default="1"/>

    <xacro:include filename="$(find floatbot_description)/urdf/floatbot_base.urdf.xacro"/>
    <xacro:include filename="$(find floatbot_description)/urdf/voxel.urdf.xacro"/>
    <xacro:include filename="$(find floatbot_description)/urdf/apriltag.urdf.xacro"/>

    <xacro:floatbot_base prefix="$(arg prefix)"/>

    <xacro:voxel prefix="$(arg prefix)" parent="$(arg prefix)base_link">
        <origin xyz="0.0 0.0 ${(base_height + voxel_width)/2}" rpy="0.0 0.0 0.0"/>
    </xacro:voxel>

    <xacro:apriltag prefix="$(arg prefix)" tag_id="$(arg tag_id)" tag_size=".142" parent="$(arg prefix)voxel_link">
        <origin xyz="0.0 0.0 ${(voxel_width)/2}" rpy="0.0 0.0 0.0"/>
    </xacro:apriltag>
</robot>