<?xml version="1.0" encoding="UTF-8"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="apriltag">
    <xacro:property name="tag_width" value=".003"/>

    <xacro:macro name="apriltag" params="prefix tag_id tag_size parent *origin">
        <link name="${prefix}tag_${tag_id}_link">
            <visual>
                <geometry>
                    <box size="${tag_size} ${tag_size} ${tag_width}"/>
                </geometry>

                <material name="white">
                    <color rgba="1.0 1.0 1.0 1.0"/>
                </material>
            </visual>
        </link>

        <joint name="${prefix}tag_${tag_id}_joint" type="fixed">
            <xacro:insert_block name="origin"/>
            
            <parent link="${prefix}${parent}"/>

            <child link="${prefix}tag_${tag_id}_link"/>
        </joint>
    </xacro:macro>
/</robot>